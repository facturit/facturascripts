    {
      "name": "Plugins y utilidades",
      "description": "Consultas auxiliares sobre el estado del sistema y los plugins instalados.",
      "item": [
        {
          "name": "Listar plugins instalados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/3/plugins",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "3",
                "plugins"
