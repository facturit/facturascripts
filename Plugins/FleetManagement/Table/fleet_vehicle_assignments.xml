<?xml version="1.0" encoding="UTF-8"?>
<table>
    <column>
        <name>id</name>
        <type>serial</type>
        <null>NO</null>
    </column>
    <column>
        <name>vehicle_id</name>
        <type>integer</type>
        <null>NO</null>
    </column>
    <column>
        <name>assignment_date</name>
        <type>date</type>
        <null>NO</null>
    </column>
    <column>
        <name>user_nick</name>
        <type>character varying(50)</type>
        <null>NO</null>
    </column>
    <column>
        <name>notes</name>
        <type>character varying(255)</type>
    </column>
    <constraint>
        <name>fleet_vehicle_assignments_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <constraint>
        <name>fleet_vehicle_assignments_vehicle_fk</name>
        <type>FOREIGN KEY (vehicle_id) REFERENCES fleet_vehicles (id) ON DELETE CASCADE</type>
    </constraint>
    <constraint>
        <name>fleet_vehicle_assignments_user_fk</name>
        <type>FOREIGN KEY (user_nick) REFERENCES users (nick) ON DELETE CASCADE</type>
    </constraint>
    <constraint>
        <name>fleet_vehicle_assignments_unique</name>
        <type>UNIQUE (vehicle_id, assignment_date)</type>
    </constraint>
</table>
