<?xml version="1.0" encoding="UTF-8"?>
<!--
    Document   : gd_file_map.xml
    Description:
        Structure for the gd_file_map table used by the Google Drive Sync plugin.
-->
<table>
    <column>
        <name>id</name>
        <type>serial</type>
        <null>NO</null>
    </column>
    <column>
        <name>idempresa</name>
        <type>integer</type>
        <null>NO</null>
    </column>
    <column>
        <name>model</name>
        <type>character varying(60)</type>
        <null>NO</null>
    </column>
    <column>
        <name>iddocument</name>
        <type>integer</type>
        <null>NO</null>
    </column>
    <column>
        <name>google_file_id</name>
        <type>character varying(128)</type>
    </column>
    <column>
        <name>google_folder_id</name>
        <type>character varying(128)</type>
    </column>
    <column>
        <name>google_web_link</name>
        <type>character varying(255)</type>
    </column>
    <column>
        <name>filename</name>
        <type>character varying(255)</type>
    </column>
    <column>
        <name>content_hash</name>
        <type>character varying(128)</type>
    </column>
    <column>
        <name>sync_status</name>
        <type>character varying(20)</type>
        <null>NO</null>
        <default>'queued'</default>
    </column>
    <column>
        <name>sync_error</name>
        <type>text</type>
    </column>
    <column>
        <name>last_synced_at</name>
        <type>timestamp</type>
    </column>
    <column>
        <name>created_at</name>
        <type>timestamp</type>
        <null>NO</null>
        <default>CURRENT_TIMESTAMP</default>
    </column>
    <column>
        <name>updated_at</name>
        <type>timestamp</type>
        <null>NO</null>
        <default>CURRENT_TIMESTAMP</default>
    </column>
    <constraint>
        <name>gd_file_map_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <constraint>
        <name>gd_file_map_unique_doc</name>
        <type>UNIQUE (model,iddocument,idempresa)</type>
    </constraint>
    <constraint>
        <name>ca_gd_file_map_idempresa</name>
        <type>FOREIGN KEY (idempresa) REFERENCES empresas (idempresa) ON DELETE CASCADE ON UPDATE CASCADE</type>
    </constraint>
    <index>
        <name>gd_file_map_idx_doc</name>
        <columns>model,iddocument,idempresa</columns>
    </index>
    <index>
        <name>gd_file_map_idx_file</name>
        <columns>google_file_id</columns>
    </index>
    <index>
        <name>gd_file_map_idx_status</name>
        <columns>sync_status</columns>
    </index>
    <index>
        <name>gd_file_map_idx_updated</name>
        <columns>updated_at</columns>
    </index>
</table>
