<?xml version="1.0" encoding="UTF-8"?>
<view>
    <columns>
        <column name="codigo" order="100">
            <widget type="text" fieldname="codigo_paciente" onclick="EditPaciente"/>
        </column>
        <column name="nombre" order="110">
            <widget type="text" fieldname="nombre"/>
        </column>
        <column name="apellidos" order="120">
            <widget type="text" fieldname="apellidos"/>
        </column>
        <column name="estado" order="130">
            <widget type="select" fieldname="estado">
                <values>
                    <value value="Activo" title="Activo"/>
                    <value value="Inactivo" title="Inactivo"/>
                    <value value="Archivado" title="Archivado"/>
                </values>
            </widget>
        </column>
        <column name="profesional" order="140">
            <widget type="select" fieldname="profesional_asignado" onclick="EditUser">
                <values source="users" fieldcode="nick" fieldtitle="nick"/>
            </widget>
        </column>
        <column name="telefono" order="150">
            <widget type="text" fieldname="telefono"/>
        </column>
        <column name="email" order="160">
            <widget type="text" fieldname="email"/>
        </column>
        <column name="metodo" order="170">
            <widget type="text" fieldname="metodo_contacto_preferido"/>
        </column>
        <column name="fecha-alta" order="180">
            <widget type="date" fieldname="fecha_alta"/>
        </column>
        <column name="alertas" order="190">
            <widget type="textarea" fieldname="banderas_alerta"/>
        </column>
    </columns>
</view>
